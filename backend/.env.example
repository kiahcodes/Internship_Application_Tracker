PORT=5000
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (replace [YOUR-PASSWORD]).
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres
# Supabase: Project Settings -> API. The service_role key is a secret - never expose it to the frontend.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=resumes
JWT_SECRET=change-me-to-a-long-random-string
SCRAPER_ENABLED=true

# Posters need this code to sign up. Leave empty to close poster sign-ups.
POSTER_INVITE_CODE=change-me
# Where reset links point, and optional SMTP for sending them (otherwise they print in this console).
APP_URL=http://localhost:5173
# SMTP_URL=smtps://user:password@smtp.example.com
# MAIL_FROM=Internship Tracker <no-reply@example.com>
